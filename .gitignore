# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files
# Ignore every .env* variant by default, then re-allow the two that are
# intentionally tracked. .env.production MUST stay tracked: Vite reads it during
# `npm run build`, and if it is missing the production build silently falls back
# to local-only mode (no Firebase, no cloud sync).
.env*
!.env.example
!.env.production

# Hermes agent profile state (session-local, not source)
.hermes/

# Firebase
.firebase/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Email-mesh runtime/private artifacts (source and synthetic fixtures are tracked)
integrations/email-mesh/.venv/
integrations/email-mesh/**/__pycache__/
integrations/email-mesh/**/*.py[cod]
integrations/email-mesh/*.sqlite3*
integrations/email-mesh/*.db*
integrations/email-mesh/**/config.json
integrations/email-mesh/**/runtime.env
integrations/email-mesh/**/token*.json
integrations/email-mesh/**/gmail-token.json
integrations/email-mesh/**/client_secret*.json
integrations/email-mesh/**/oauth-client.json
integrations/email-mesh/**/firebase-admin*.json
integrations/email-mesh/**/service-account*.json
integrations/email-mesh/archive/
integrations/email-mesh/backups/
integrations/email-mesh/private/
integrations/email-mesh/state/
integrations/email-mesh/n8n/*verification*.json
integrations/email-mesh/n8n/import-result.json
integrations/email-mesh/n8n/execution-*.json
